# SignalWire project (Dashboard > API). The token needs the AI Chat scope.
SIGNALWIRE_SPACE_NAME=myspace            # or myspace.signalwire.com
SIGNALWIRE_PROJECT_ID=
SIGNALWIRE_TOKEN=
# Public HTTPS URL of this app (your deploy URL, or a tunnel such as cloudflared)
SWML_PROXY_URL_BASE=https://your-app.example.com
PORT=3000
# Optional
# SWML_BASIC_AUTH_USER=           # auto-generated when unset
# SWML_BASIC_AUTH_PASSWORD=
# CHAT_PUBLISHABLE_KEY=           # random per boot when unset
# FABRIC_HANDLER_NAME=healthcare-front-desk
# CALLS_PER_IP_PER_HOUR=20
